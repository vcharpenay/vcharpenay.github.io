// lire le deuxième opérande y depuis l'entrée, le stocker dans D

get;
mov(a, d);

// lire le premier opérande x, le conserver dans A

get;

// initialiser C, qui contiendra le résultat de la division z, à 0

mov(0, c);

// si x < y, alors z = x/y, aller à la fin du programme

cmp(d, a);
jb(9);

// sinon, soustraire y à x et incrémenter z

sub(d, a);
add(1, c);

// revenir à la comparaison de y à x

jmp(4);

// déplacer le résultat dans A pour l'afficher en sortie

mov(c, a);
put;