// int max(x, y) { return x < y ? y : x; }
// int x = max(1, 12);

// simuler une exécution en cours avec des valeurs de registres arbitraires

mov(7, a);
mov(33, b);

// copier l'ensemble des registres de travail (excepté SP) dans la pile
// (SP pointe vers la valeur de retour de la fonction)

mov(a, [sp+1]);
mov(c, [sp+2]);
mov(d, [sp+3]);
mov(b, [sp+4]);
mov(bp, [sp+5]);

// copier SP dans BP avant de mettre à jour SP
// (1 valeur de retour + 5 valeurs de registre empilées)

mov(sp, bp);
add(6, sp);

// copier les arguments de la fonction dans la pile

mov(1, [sp]);
add(1, sp);
mov(12, [sp]);
add(1, sp);

// exécuter le corps de la fonction (si x < y, retourner y, sinon retourner x)
// après avoir copié les deux opérandes dans des registres

mov([sp-2], a);
mov([sp-1], b);
cmp(a, b);
jbe(17);
mov(b, [bp]);
jmp(18);
mov(a, [bp]);

// rétablir SP à sa valeur avant appel

mov(bp, sp);

// restaurer les registres de travail depuis la pile

mov(bp, [sp+5]);
mov(b, [sp+4]);
mov(d, [sp+3]);
mov(c, [sp+2]);
mov(a, [sp+1]);

// empiler définitivement la valeur de retour en tant que variable x

add(1, sp);