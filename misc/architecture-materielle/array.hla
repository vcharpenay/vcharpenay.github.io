// int[] tab = { 116, 105, 99 };
// tab[1] = 97;
// for (int i = 0; i < tab.length; i++) System.out.println(tab[i]);

// stocker la référence au tableau tab dans BX
// (pour simuler une allocation dynamique de mémoire)

mov(32, bx);

// initialiser tab avec une taille de 3

mov(3, [bx]);

// remplir tab avec le code ASCII pour 't', 'i', 'c'

mov(116, [bx+1]);
mov(105, [bx+2]);
mov(99, [bx+3]);

// modifier 'i' en 'a'

mov(97, [bx+2]);

// afficher en sortie le contenu du tableau, élément par élément
// (la variable i n'est pas matérialisée, on décrémente CX à la place)

mov([bx], cx);

cmp(0, cx);
jbe(14);

add(1, bx);
sub(1, cx);
mov([bx], ax);
put;

jmp(7);