// int[] tab = { 116, 105, 99 };
// tab[1] = 97;
// for (int i = 0; i < tab.length; i++) System.out.println(tab[i]);

// stocker la référence au tableau tab dans B
// (pour simuler une allocation dynamique de mémoire)

mov(32, b);

// initialiser tab avec une taille de 3

mov(3, [b]);

// remplir tab avec le code ASCII pour 't', 'i', 'c'

mov(116, [b+1]);
mov(105, [b+2]);
mov(99, [b+3]);

// modifier 'i' en 'a'

mov(97, [b+2]);

// afficher en sortie le contenu du tableau, élément par élément
// (la variable i n'est pas matérialisée, on décrémente C à la place)

mov([b], c);

cmp(0, c);
jbe(14);

add(1, b);
sub(1, c);
mov([b], a);
put;

jmp(7);