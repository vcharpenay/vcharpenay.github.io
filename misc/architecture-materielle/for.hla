// for (i = 0; i < n; i++) { ... }

// initialiser n

mov(12, [32]);

// initialiser i dans le registre CX (compteur)

mov(0, cx);

// comparer i à n et sauter la boucle si i >= n
// sinon, en fin de bloc, incrémenter i et boucler

cmp([32], cx);
jae(6);

// ... (instructions du bloc)

add(1, cx);
jmp(2);