# a publication can also be what is being published
schema:PublicationEvent a rdfs:Class ; cowl:template "a publication event"@en .
schema:ScreeningEvent a rdfs:Class ; cowl:template "a screening"@en .
schema:SportsEvent a rdfs:Class ; cowl:template "a sports event"@en .
