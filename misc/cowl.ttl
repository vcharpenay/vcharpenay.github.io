schema:HighSchool a rdfs:Class ; cowl:template "a high school"@en .
schema:MiddleSchool a rdfs:Class ; cowl:template "a middle school"@en .
schema:Preschool a rdfs:Class ; cowl:template "a preschool"@en .
schema:School a rdfs:Class ; cowl:template "a school"@en .
schema:GovernmentOrganization a rdfs:Class ; cowl:template "a governmental organization"@en .
schema:MedicalOrganization a rdfs:Class ; cowl:template "a medical organization"@en .
