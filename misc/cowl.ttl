schema:Blog a rdfs:Class ; cowl:template "a blog"@en .
schema:Book a rdfs:Class ; cowl:template "a book"@en .
schema:Chapter a rdfs:Class ; cowl:template "a book chapter"@en .
schema:Clip a rdfs:Class ; cowl:template "a clip"@en .
schema:MovieClip a rdfs:Class ; cowl:template "a movie clip"@en .
schema:RadioClip a rdfs:Class ; cowl:template "a radio clip"@en .
schema:TVClip a rdfs:Class ; cowl:template "a TV clip"@en .
schema:VideoGameClip a rdfs:Class ; cowl:template "a video game clip"@en .
schema:Code a rdfs:Class ; cowl:template "code"@en .
schema:Collection a rdfs:Class ; cowl:template "a collection"@en .
schema:ComicStory a rdfs:Class ; cowl:template "a comic story"@en .
schema:Comment a rdfs:Class ; cowl:template "a comment"@en .
schema:Conversation a rdfs:Class ; cowl:template "a conversation"@en .
schema:Course a rdfs:Class ; cowl:template "a course"@en .
# TODO likely to clash with non-creative work season/series
schema:CreativeWorkSeason a rdfs:Class ; cowl:template "a season"@en .
schema:CreativeWorkSeries a rdfs:Class ; cowl:template "a series"@en .
schema:DataCatalog a rdfs:Class ; cowl:template "a data catalog"@en .
schema:Dataset a rdfs:Class ; cowl:template "a dataset"@en .
schema:Diet a rdfs:Class ; cowl:template "a diet"@en .
schema:DigitalDocument a rdfs:Class ; cowl:template "a digital document"@en .
schema:Episode a rdfs:Class ; cowl:template "an episode"@en .
schema:ExercisePlan a rdfs:Class ; cowl:template "an exercise plan"@en .
schema:Game a rdfs:Class ; cowl:template "a game"@en .
schema:HowTo a rdfs:Class ; cowl:template "a how-to"@en .
schema:Map a rdfs:Class ; cowl:template "a map"@en .
schema:MediaObject a rdfs:Class ; cowl:template "a media file"@en .
schema:AudioObject a rdfs:Class ; cowl:template "an audio file"@en .
schema:DataDownload a rdfs:Class ; cowl:template "part of a dataset"@en .
schema:ImageObject a rdfs:Class ; cowl:template "an image file"@en .
schema:MusicVideoObject a rdfs:Class ; cowl:template "a music video file"@en .
schema:TextObject a rdfs:Class ; cowl:template "a text file"@en .
schema:VideoObject a rdfs:Class ; cowl:template "a video file"@en .
schema:Menu a rdfs:Class ; cowl:template "a menu"@en .
schema:Message a rdfs:Class ; cowl:template "a menu item"@en .
