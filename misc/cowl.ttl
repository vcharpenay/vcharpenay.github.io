# acronym as class (case-sensitive label)
schema:NGO a rdfs:Class ; cowl:template "an NGO"@en .
schema:PerformingGroup a rdfs:Class ; cowl:template "a performance group"@en .
schema:DanceGroup a rdfs:Class ; cowl:template "a dance group"@en .
schema:MusicGroup a rdfs:Class ; cowl:template "a musical group"@en .
schema:TheaterGroup a rdfs:Class ; cowl:template "a theater group"@en .
schema:PoliticalParty a rdfs:Class ; cowl:template "a political party"@en .
schema:SportsOrganization a rdfs:Class ; cowl:template "a sports organization"@en .
schema:SportsTeam a rdfs:Class ; cowl:template "a sports team"@en .
# language-sensitive label
schema:WorkersUnion a rdfs:Class ; cowl:template "a labor union"@en-US .
schema:WorkersUnion a rdfs:Class ; cowl:template "a labour union"@en-UK .
schema:BusinessEvent a rdfs:Class ; cowl:template "a business event"@en .
# TODO distinguish with Course (learning resource)?
schema:CourseInstance a rdfs:Class ; cowl:template "a course"@en .
