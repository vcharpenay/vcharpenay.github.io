@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <http://schema.org/> .
@prefix cowl: <http://purl.org/controwlled#> .

cowl:template
    a rdf:Property ;
    rdfs:label "template"@en ;
    rdfs:comment "Property template to generate Controwlled sentences"@en .

cowl:expression
    a rdf:Property ;
    rdfs:label "expression"@en ;
    rdfs:comment "Words denoting the node (class or instance)"@en .

schema:Thing a rdfs:Class ; cowl:template "something"@en .
schema:Person a rdfs:Class ; cowl:template "a person"@en .
# application of the a/an rule
schema:Organization a rdfs:Class ; cowl:template "an organization"@en .
schema:Place a rdfs:Class ; cowl:template "a place"@en .
# uncountable entity as class
schema:CreativeWork a rdfs:Class ; cowl:template "creative work"@en .
# adjective as class
schema:Intangible a rdfs:Class ; cowl:template "intangible"@en .
schema:Action a rdfs:Class ; cowl:template "an action"@en .
schema:MedicalEntity a rdfs:Class ; cowl:template "a medical entity"@en .
